{
  "name": "excel-record-management-system",
  "version": "1.0.0",
  "description": "Secure, LAN-accessible Excel Search & Record Management Website for business records",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "node scripts/start-dev.js",
    "start": "node server/src/server.js",
    "build": "cd client && npm run build",
    "vercel-build": "npm --prefix client install && npm --prefix client run build",
    "test": "cd server && npm test",
    "generate-samples": "node scripts/generate-sample-data.js",
    "get-ip": "node server/src/utils/networkIp.js",
    "backup": "node scripts/backup-db.js",
    "restore": "node scripts/restore-db.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.16.0",
    "pdfkit-table": "^0.1.99",
    "pg": "^8.13.1",
    "xlsx": "^0.18.5"
  },
  "keywords": [
    "excel",
    "record-management",
    "search",
    "postgresql",
    "vite",
    "react"
  ],
  "author": "",
  "license": "ISC"
}
