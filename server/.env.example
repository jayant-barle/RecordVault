# Server Environment Configuration
PORT=5000
HOST=0.0.0.0

# Security Secrets
JWT_SECRET=excel-mgmt-secret-key-change-this-in-production-lan-token-928374
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL)
# If PostgreSQL is running locally or on LAN, provide the connection string:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/excel_records

# Default Admin Credentials for initial setup
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=Admin@12345

# Allowed Client Origin (for CORS)
CLIENT_ORIGIN=*
